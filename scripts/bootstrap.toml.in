# rustc with the RX backend. scripts/setup.sh writes this to rust/bootstrap.toml
# with @ROOT@ replaced by the repository root.
change-id = "ignore"

[llvm]
# Use the LLVM built in build/llvm (with the RX target) instead of building
# or downloading one.
download-ci-llvm = false

[build]
# rx-none-elf: bootstrap also builds core, alloc and compiler_builtins for it,
# which the dist archives ship, so programs build without -Zbuild-std.
target = ["x86_64-unknown-linux-gnu", "rx-none-elf"]
# Do not let bootstrap reset src/llvm-project (it carries the RX backend).
submodules = false
docs = false
extended = false
# rustc crates need 1-3 GB of memory each.
jobs = 4
# Appended to rustc -V ("rustc 1.100.0 (b216d1858 2026-11-14) (CDEF-inc RX
# fork)"), so this toolchain is not taken for an official Rust release. It is
# also part of the crate IDs: crates built by another rustc do not mix in.
description = "CDEF-inc RX fork"

[rust]
# The channel of the rust branch (src/ci/channel): "stable" on rx-1.100, so
# rustc says 1.100.0 (with its commit) instead of 1.100.0-dev. Unstable
# features (-Zbuild-std) then need RUSTC_BOOTSTRAP=1; asm!, c-variadic
# definitions and the target features of RX are stable in the fork.
channel = "auto-detect"
download-rustc = false
lld = false
# build/llvm only has the libraries, llc and llvm-mc.
llvm-tools = false
debug-assertions = false

[target.x86_64-unknown-linux-gnu]
llvm-config = "@ROOT@/build/llvm/bin/llvm-config"

[target.rx-none-elf]
# The prebuilt core etc. are RXv1 code, which runs on every RX core; a
# program's own code still follows its target-cpu.
rustflags = ["-Ctarget-cpu=rxv1"]
# No C for RX: compiler_builtins is Rust-only (with its mem feature, which
# bootstrap turns on for no-std targets). bootstrap still wants a C compiler
# and an archiver for every target; the host's stand in (setup.sh puts
# MSVC's on Windows), as nothing is compiled with them.
optimized-compiler-builtins = false
cc = "cc"
ar = "ar"
