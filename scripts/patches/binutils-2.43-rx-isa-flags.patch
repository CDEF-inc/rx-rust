--- a/bfd/elf32-rx.c
+++ b/bfd/elf32-rx.c
@@ -3151,6 +3151,16 @@
   else if (old_flags != new_flags)
     {
       flagword known_flags;
+      flagword isa_flags;
+
+      /* The output needs the highest instruction set any input uses.
+	 Without this, linking objects whose flags differ in any other
+	 bit (string instructions, say) dropped the V2/V3 bits.  */
+      isa_flags = old_flags | new_flags;
+      if (isa_flags & E_FLAG_RX_V3)
+	isa_flags = E_FLAG_RX_V3;
+      else
+	isa_flags &= E_FLAG_RX_V2;
 
       if (old_flags & E_FLAG_RX_SINSNS_SET)
 	{
@@ -3176,7 +3186,8 @@
 	     deprecated flags.  */
 	  if (no_warn_mismatch)
 	    {
-	      elf_elfheader (obfd)->e_flags = (new_flags | old_flags) & known_flags;
+	      elf_elfheader (obfd)->e_flags
+		= ((new_flags | old_flags) & known_flags) | isa_flags;
 	    }
 	  else
 	    {
@@ -3193,7 +3204,7 @@
 	    }
 	}
       else
-	elf_elfheader (obfd)->e_flags = new_flags & known_flags;
+	elf_elfheader (obfd)->e_flags = (new_flags & known_flags) | isa_flags;
     }
 
   if (error)
